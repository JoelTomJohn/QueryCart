# QueryCart Environment Configuration

# Google Gemini API Key (Required for live AI queries)
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (e.g. gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# Path to the orders dataset (default: orders.csv in project root)
ORDERS_CSV_PATH=orders.csv

# Server Configuration
PORT=8000
ENVIRONMENT=development
